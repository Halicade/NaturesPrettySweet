<?xml version="1.0" encoding="utf-8"?>

<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/TerrainDef[defName="LavaDeep"]/tags</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/TerrainDef[defName="LavaDeep"]</xpath>
            <value>
                <tags />
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[defName="LavaDeep"]/tags</xpath>
        <value>
            <li>TKKN_Lava</li>
        </value>
    </Operation>

    <Operation Class="TKKN_NPS.Toggleables">
        <setting>LavaReplace</setting>
        <patchOp Class="PatchOperationReplace">
            <xpath>Defs/BiomeDef[defName="TKKN_VolcanicFlow"]/terrainPatchMakers/li</xpath>
            <value>
                <li>
                    <perlinFrequency>0.04</perlinFrequency>
                    <thresholds>
                        <li>
                            <terrain>TKKN_LavaRock_RoughHewn</terrain>
                            <min>0.3</min>
                            <max>.6</max>
                        </li>
                        <li>
                            <terrain>LavaDeep</terrain>
                            <min>.6</min>
                            <max>999</max>
                        </li>
                    </thresholds>
                </li>
            </value>
            
        </patchOp>
    </Operation>


</Patch>