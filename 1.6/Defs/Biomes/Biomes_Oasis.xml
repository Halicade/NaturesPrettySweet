<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <BiomeDef>
        <defName>TKKN_Oasis</defName>
        <label>desert oasis</label>
        <description>A large amount of water surrounded by a very dry area. The oasis itself has rich soil and lots of animals, but is surrounded by extreme desert.</description>
        <workerClass>TKKN_NPS.NPS_BiomeWorker_Oasis</workerClass>
        <animalDensity>0.35</animalDensity>
        <plantDensity>0.05</plantDensity>
        <forageability>0.9</forageability>
        <foragedFood>RawAgave</foragedFood>
        <settlementSelectionWeight>0.9</settlementSelectionWeight>
        <texture>TKKN_NPS/World/Biomes/Oasis</texture>
        <implemented>true</implemented>
        <diseaseMtbDays>80</diseaseMtbDays>
        <extraGenSteps>
            <li>NPS_Oasis</li>
            <li>NPS_PostOasisPlants</li>
        </extraGenSteps>
        <diseases>
            <li>
                <diseaseInc>Disease_Flu</diseaseInc>
                <commonality>100</commonality>
            </li>
            <li>
                <diseaseInc>Disease_Plague</diseaseInc>
                <commonality>80</commonality>
            </li>
            <li>
                <diseaseInc>Disease_FibrousMechanites</diseaseInc>
                <commonality>30</commonality>
            </li>
            <li>
                <diseaseInc>Disease_SensoryMechanites</diseaseInc>
                <commonality>30</commonality>
            </li>
            <li>
                <diseaseInc>Disease_GutWorms</diseaseInc>
                <commonality>60</commonality>
            </li>
            <li>
                <diseaseInc>Disease_MuscleParasites</diseaseInc>
                <commonality>60</commonality>
            </li>
        </diseases>
        <terrainsByFertility>
            <li>
                <terrain>Sand</terrain>
                <min>-999</min>
                <max>999</max>
            </li>
        </terrainsByFertility>
        <baseWeatherCommonalities>
            <Clear>14</Clear>
            <Rain>2</Rain>
            <DryThunderstorm>1</DryThunderstorm>
            <RainyThunderstorm>1</RainyThunderstorm>
            <TKKN_DustStorm>3</TKKN_DustStorm>
            <TKKN_DryDustStorm>3</TKKN_DryDustStorm>
            <Sandstorm MayRequire="Ludeon.Rimworld.Odyssey">3</Sandstorm>
            <SnowGentle>3</SnowGentle>
            <SnowHard>3</SnowHard>
            <GrayPall MayRequire="Ludeon.RimWorld.Anomaly">1</GrayPall>
        </baseWeatherCommonalities>
        <maxFishPopulation>320</maxFishPopulation>
        <fishTypes MayRequire="Ludeon.RimWorld.Odyssey">
            <freshwater_Common>
                <Fish_Guppy MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Guppy>
            </freshwater_Common>
            <freshwater_Uncommon>
                <Fish_Tilapia MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tilapia>
            </freshwater_Uncommon>
            <saltwater_Common>
                <Fish_Bluefish MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Bluefish>
            </saltwater_Common>
            <saltwater_Uncommon>
                <Fish_Tuna MayRequire="Ludeon.RimWorld.Odyssey">1</Fish_Tuna>
            </saltwater_Uncommon>
            <rareCatchesSetMaker MayRequire="Ludeon.RimWorld.Odyssey">RareFishingCatches_Hot</rareCatchesSetMaker>
        </fishTypes>
        <wildPlants>
            <Plant_Grass>3</Plant_Grass>
            <TKKN_PlantTreeBaobab>.5</TKKN_PlantTreeBaobab>
            <TKKN_PlantTreeGum>.5</TKKN_PlantTreeGum>
            <TKKN_PlantCactusPricklyPear>.3</TKKN_PlantCactusPricklyPear>
            <TKKN_PlantCactusSanPedro>.5</TKKN_PlantCactusSanPedro>
            <TKKN_PlantCactusBarrel>.5</TKKN_PlantCactusBarrel>
            <TKKN_PlantDesertShrubA>1</TKKN_PlantDesertShrubA>
            <TKKN_PlantDesertShrubB>1</TKKN_PlantDesertShrubB>
            <TKKN_PlantSucculants>.5</TKKN_PlantSucculants>
            <TKKN_TreeOcotillo>.3</TKKN_TreeOcotillo>
            <TKKN_PlantCatTails>.6</TKKN_PlantCatTails>
            <TKKN_PlantLilypad>.5</TKKN_PlantLilypad>
            <Plant_PincushionCactus>.5</Plant_PincushionCactus>
            <Plant_Dandelion>0.2</Plant_Dandelion>
            <Plant_TreePalm>0.3</Plant_TreePalm>
            <Plant_TreeBamboo>0.3</Plant_TreeBamboo>
            <Plant_Agave>0.3</Plant_Agave>
            <Plant_Bush>0.25</Plant_Bush>
            <Plant_GrayGrass MayRequire="Ludeon.RimWorld.Biotech">5</Plant_GrayGrass>
            <Plant_PebbleCactus MayRequire="Ludeon.RimWorld.Biotech">1</Plant_PebbleCactus>
        </wildPlants>
        <wildAnimals>
            <Gazelle>1</Gazelle>
            <Emu>0.2</Emu>
            <Megascarab>1</Megascarab>
            <Iguana>0.7</Iguana>
            <Dromedary>0.5</Dromedary>
            <Boomalope>0.2</Boomalope>
            <Ostrich>0.2</Ostrich>
            <Rat>0.30</Rat>
            <Cougar>0.4</Cougar>
            <Rhinoceros>0.02</Rhinoceros>
            <Fox_Fennec>0.02</Fox_Fennec>
            <Hippo MayRequire="Ludeon.Rimworld.Odyssey">0.08</Hippo>
        </wildAnimals>
        <allowedPackAnimals>
            <li>Muffalo</li>
            <li>Dromedary</li>
        </allowedPackAnimals>
        <modExtensions>
            <li Class="GeologicalLandforms.BiomeProperties" MayRequire="m00nl1ght.GeologicalLandforms">

                <allowLandforms>true</allowLandforms>
                <allowBiomeTransitions>true</allowBiomeTransitions>
                <!--
                These make water spawn in the oasis water which looks weird.
                Probably need to block more but that's for future me
                -->
                <disallowedLandforms>
                    <li>Oasis</li>
                    <li>Cove</li>
                    <li>CoveWithIsland</li>
                    <li>Fjord</li>
                    <li>SecludedCove</li>
                </disallowedLandforms>

                <isWaterCovered>false</isWaterCovered>

            </li>
        </modExtensions>
    </BiomeDef>
</Defs>