        <geyserCountFactor>1.5</geyserCountFactor>
        <settlementSelectionWeight>.6</settlementSelectionWeight>
        <texture>TKKN_NPS/World/Biomes/Lavatropical</texture>
        <riverbankSizeRange>6~9</riverbankSizeRange>
