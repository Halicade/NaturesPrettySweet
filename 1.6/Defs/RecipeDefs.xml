<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <RecipeDef>
    <defName>TKKN_ConvertRedwood</defName>
    <label>convert redwood to regular wood</label>
    <description>Convert Redwood to regular wood. This process is not reversible.</description>
    <jobString>converting wood.</jobString>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <workAmount>2000</workAmount>
    <workSkillLearnFactor>0.2</workSkillLearnFactor>
    <workSkill>Plants</workSkill>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RedWoodLog</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RedWoodLog</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <WoodLog>20</WoodLog>
    </products>
    <recipeUsers>
      <li>CraftingSpot</li>
    </recipeUsers>
    
  </RecipeDef>

</Defs>
