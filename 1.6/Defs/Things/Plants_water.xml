<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <ThingDef ParentName="PlantBase" Name="NPS_WaterPlants" Abstract="True">
        <plant>
            <wildPlantUseDistanceToShore>true</wildPlantUseDistanceToShore>
            <completelyIgnoreFertility>true</completelyIgnoreFertility>
            <showInFrozenWater>false</showInFrozenWater>
        </plant>
    </ThingDef>

    <ThingDef ParentName="NPS_WaterPlants">
        <defName>TKKN_PlantBarnacles</defName>
        <label>barnacles</label>
        <description>Exclusively marine arthropods that tend to live in shallow and tidal waters</description>
        <statBases>
            <MaxHitPoints>35</MaxHitPoints>
            <Nutrition>0.25</Nutrition>
        </statBases>
        <pathCost>18</pathCost>
        <graphicData>
            <texPath>TKKN_NPS/Things/HarvestableMisc/VarientHarvestable/Barnacles</texPath>
            <graphicClass>Graphic_Random</graphicClass>
            <!-- maybe this will stop it from blowing in the wind -->
            <!--<shaderType>Cutout</shaderType>-->
        </graphicData>
        <ingestible />
        <selectable>true</selectable>
        <neverMultiSelect>false</neverMultiSelect>
        <plant>
            <harvestTag>Standard</harvestTag>
            <harvestedThingDef>TKKN_ShellfishMeat</harvestedThingDef>
            <harvestYield>10</harvestYield>
            <!--
      <fertilityMin>.0001</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      -->
            <growDays>3</growDays>
            <dieIfLeafless>false</dieIfLeafless>
            <harvestWork>60</harvestWork>
            <immatureGraphicPath>TKKN_NPS/Things/HarvestableMisc/Barnacles</immatureGraphicPath>
            <visualSizeRange>0.4~0.85</visualSizeRange>
            <topWindExposure>0</topWindExposure>
            <wildTerrainTags>
                <li>Beach</li>
                <li>Ocean</li>
            </wildTerrainTags>
        </plant>
    </ThingDef>
    <ThingDef ParentName="NPS_WaterPlants">
        <defName>TKKN_PlantLilypad</defName>
        <label>lilypad</label>
        <description>Aquatic herbs that live in temperate and tropical climates.</description>
        <statBases>
            <MaxHitPoints>35</MaxHitPoints>
            <Nutrition>0.25</Nutrition>
        </statBases>
        <pathCost>18</pathCost>
        <graphicData>
            <texPath>TKKN_NPS/Things/Plant/Lilypads</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <hideAtSnowOrSandDepth>0.1</hideAtSnowOrSandDepth>
        <ingestible />
        <plant>
            <!--
      <fertilityMin>.0001</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      -->
            <growDays>3</growDays>
            <dieIfLeafless>true</dieIfLeafless>
            <harvestWork>60</harvestWork>
            <visualSizeRange>0.7~0.85</visualSizeRange>
            <topWindExposure>0.4</topWindExposure>
            <wildTerrainTags>
                <li>WaterMarshy</li>
                <li>WaterFreshShallow</li>
                <li>Spring</li>
            </wildTerrainTags>
        </plant>
    </ThingDef>
    <ThingDef ParentName="NPS_WaterPlants">
        <defName>TKKN_PlantCatTails</defName>
        <label>cattails</label>
        <description>Also known as bulrushes. A semi-aquatic plants with an brown, cigar-shaped, edible flower.</description>
        <statBases>
            <MaxHitPoints>85</MaxHitPoints>
            <Nutrition>0.3</Nutrition>
        </statBases>
        <pathCost>18</pathCost>
        <graphicData>
            <texPath>TKKN_NPS/Things/Plant/VarientHarvestable/CatTails</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <hideAtSnowOrSandDepth>0.6</hideAtSnowOrSandDepth>
        <ingestible />
        <selectable>true</selectable>
        <neverMultiSelect>false</neverMultiSelect>
        <plant>
            <harvestTag>Standard</harvestTag>
            <harvestedThingDef>TKKN_WildGreens</harvestedThingDef>
            <harvestYield>3</harvestYield>
            <!--
      <fertilityMin>.0001</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      -->
            <growDays>3</growDays>
            <dieIfLeafless>true</dieIfLeafless>
            <harvestWork>60</harvestWork>
            <maxMeshCount>4</maxMeshCount>
            <immatureGraphicPath>TKKN_NPS/Things/Plant/CatTails</immatureGraphicPath>
            <visualSizeRange>0.7~0.85</visualSizeRange>
            <topWindExposure>0.4</topWindExposure>
            <wildTerrainTags>
                <li>Mud</li>
                <li>WaterMarshy</li>
                <li>WaterFreshShallow</li>
            </wildTerrainTags>
        </plant>
    </ThingDef>
    <ThingDef ParentName="NPS_WaterPlants">
        <defName>TKKN_PlantWatercress</defName>
        <label>watercress</label>
        <description>Also known as yellowcress. Edible aquatic plant species that's sweeter in the winter</description>
        <statBases>
            <MaxHitPoints>85</MaxHitPoints>
            <Nutrition>0.3</Nutrition>
        </statBases>
        <pathCost>18</pathCost>
        <graphicData>
            <texPath>TKKN_NPS/Things/Plant/Watercress</texPath>
            <graphicClass>Graphic_Random</graphicClass>
        </graphicData>
        <hideAtSnowOrSandDepth>0.6</hideAtSnowOrSandDepth>
        <ingestible />
        <selectable>true</selectable>
        <neverMultiSelect>false</neverMultiSelect>
        <plant>
            <harvestTag>Standard</harvestTag>
            <harvestedThingDef>TKKN_WildGreens</harvestedThingDef>
            <harvestYield>3</harvestYield>
            <!--
      <fertilityMin>.0001</fertilityMin>
      <fertilitySensitivity>0</fertilitySensitivity>
      -->
            <growDays>3</growDays>
            <dieIfLeafless>true</dieIfLeafless>
            <harvestWork>60</harvestWork>
            <maxMeshCount>4</maxMeshCount>
            <visualSizeRange>0.7~0.85</visualSizeRange>
            <topWindExposure>0.4</topWindExposure>
            <wildTerrainTags>
                <li>WaterMarshy</li>
                <li>WaterFreshShallowStill</li>
            </wildTerrainTags>
        </plant>
    </ThingDef>


</Defs>