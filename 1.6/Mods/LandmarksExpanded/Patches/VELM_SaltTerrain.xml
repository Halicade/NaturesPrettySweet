<?xml version="1.0" encoding="utf-8"?>

<Patch>
    <!-- Needs to occur after inheritance because they inherit from Sand -->
    
    <Operation Class="PostInheritanceOperation.Patch">
        <operation Class="PatchOperationreplace">
            <xpath>Defs/TerrainDef[defName="VEE_Salt" or defName="VEE_SaltySand"]/modExtensions/li[@Class="TKKN_NPS.TerrainWeatherReactions"]</xpath>
            <value>
                <li Class="TKKN_NPS.TerrainWeatherReactions">
                    <isSalty>True</isSalty>
                </li>
            </value>
        </operation>
    </Operation>
</Patch>