    <!-- 
    I apologize for the obscenity I have created.
    Should only create dandelions (and apply it's respective patches) 
    if nothing else has patched dandelions similarly
    -->

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName = "Plant_Dandelion"]/plant/harvestedThingDef</xpath>
        <nomatch Class="TKKN_NPS.Toggleables">
            <setting>Dandelions</setting>
            <patchOp Class="PatchOperationSequence">
                <operations>
                    <li Class="PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName = "Plant_Dandelion"]/plant</xpath>
                        <value>
                            <harvestTag>Standard</harvestTag>
                            <harvestedThingDef>TKKN_WildGreens</harvestedThingDef>
                            <harvestYield>5</harvestYield>
                            <harvestWork>100</harvestWork>
                            <harvestAfterGrowth>0.10</harvestAfterGrowth>
                        </value>
                    </li>

                    <li Class="PatchOperationReplace">
                        <xpath>Defs/ThingDef[defName = "Plant_Dandelion"]/description</xpath>
                    <!-- @formatter:off-->
                    <value>
                        <description>A tiny, edible yellow flower which grows in large clusters. Though it is often considered a weed, dandelions in bloom are quite beautiful.</description>
                    </value>
                        <!-- @formatter:on-->
                    </li>

                    <li Class="PatchOperationAdd">
                        <xpath>Defs/ThingDef[defName = "Plant_Dandelion"]</xpath>
                        <value>
                            <selectable>true</selectable>
                            <neverMultiSelect>false</neverMultiSelect>
                        </value>
                    </li>

                </operations>
            </patchOp>

        </nomatch>

    </Operation>


</Patch>