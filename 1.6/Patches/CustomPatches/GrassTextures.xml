            <xpath>Defs/ThingDef[defName = "Plant_Grass"]/graphicData/texPath</xpath>
            <value>
                <texPath>TKKN_NPS/Things/Plant/Grass</texPath>
            </value>
        </patchOp>
    </Operation>

    <Operation Class="TKKN_NPS.Toggleables">
        <setting>Dandelions</setting>
        <patchOp Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName = "Plant_TallGrass"]/graphicData/texPath</xpath>
            <value>
                <texPath>TKKN_NPS/Things/Plant/Grass</texPath>
            </value>
        </patchOp>
    </Operation>

</Patch>