<?xml version="1.0" encoding="UTF-8"?>
<Patch>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_SaltField"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <isSalty>True</isSalty>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_SoilWet"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <holdFrost>True</holdFrost>
        <wetAt>0</wetAt>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_SoilWetRich"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <holdFrost>True</holdFrost>
        <wetAt>0</wetAt>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "Soil"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetTerrain>TKKN_SoilWet</wetTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_SandWet"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "Soil"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetTerrain>TKKN_SoilWet</wetTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "Mud"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetTerrain>WaterShallow</wetTerrain>
        <freezeTerrain>
          <terrain>TKKN_MuddyIce</terrain>
        </freezeTerrain>
        <tideTerrain>WaterOceanShallow</tideTerrain>
        <wetAt>1</wetAt>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "SoilRich"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetTerrain>TKKN_SoilWetRich</wetTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "Sand"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetTerrain>TKKN_SandWet</wetTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_Lava"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetAt>2</wetAt>
        <temperatureAdjust>50</temperatureAdjust>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_LavaDeep"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <temperatureAdjust>50</temperatureAdjust>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_RiverDeposit"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <floodTerrain>WaterShallow</floodTerrain>
        <freezeTerrain>
          <terrain>TKKN_MuddyIce</terrain>
        </freezeTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "Riverbank"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <floodTerrain>WaterShallow</floodTerrain>
        <freezeTerrain>
          <terrain>TKKN_MuddyIce</terrain>
        </freezeTerrain>

        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/TerrainDef[defName = "Riverbank"]/tags</xpath>
    <value>
      <li>Riverbank</li>
    </value>
  </Operation>
    <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_SandBeachWetSalt"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <tideTerrain>WaterOceanShallow</tideTerrain>
        <isSalty>True</isSalty>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "MarshyTerrain"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <floodTerrain>Marsh</floodTerrain>
        <freezeTerrain>
          <terrain>TKKN_MuddyIce</terrain>
        </freezeTerrain>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "TKKN_WetMossyTerrain"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <floodTerrain>Marsh</floodTerrain>
        <freezeTerrain>
          <terrain>TKKN_MuddyIce</terrain>
        </freezeTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "Gravel"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/TerrainDef[defName = "MossyTerrain"]</xpath>
    <value>
      <li Class="TKKN_NPS.TerrainWeatherReactions">
        <wetTerrain>TKKN_WetMossyTerrain</wetTerrain>
        <holdFrost>True</holdFrost>
      </li>
    </value>
  </Operation>
